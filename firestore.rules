rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Meal allocations: read, create, update, delete allowed for application & canteen kiosk
    match /meal_allocations/{allocationId} {
      allow read, write: if true;
    }
    
    // Master employee records & biometric IDs
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // Employee subsidy categories (Free Meal, Half Paid, Not Paid)
    match /employee_categories/{categoryId} {
      allow read, write: if true;
    }
    
    // Plant departments & sections
    match /departments/{departmentId} {
      allow read, write: if true;
    }
    
    // System users & administrative credentials
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default rule for all other collections
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
