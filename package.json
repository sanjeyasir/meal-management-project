{
  "name": "hayleys-meal-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Hayleys Eco Solutions Meal Management System Desktop and Web Application",
  "author": "Hayleys Eco Solutions",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "middleware": "node server/middlewareServer.js",
    "web:dev": "concurrently -k \"node server/middlewareServer.js\" \"vite\"",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "deploy": "npm run web:build && npx firebase deploy --only hosting",
    "deploy:all": "npm run web:build && npx firebase deploy",
    "desktop:dev": "concurrently -k \"node server/middlewareServer.js\" \"vite\" \"cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "desktop:start": "vite build && electron .",
    "desktop:build": "node scripts/build-desktop.js",
    "app:dev": "concurrently -k \"node server/middlewareServer.js\" \"vite\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^5.24.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "ws": "^8.18.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "vite": "^6.2.0"
  }
}
